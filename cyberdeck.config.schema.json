{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/cyberdeck.config.schema.json",
  "title": "Cyberdeck MCP configuration",
  "description": "Policy for the cyberdeck MCP server: model catalog, kind presets, Pi tool allowlists, roots, and limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "defaultModel",
    "models",
    "workspaceRoots",
    "artifactDirectory",
    "pi",
    "limits",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provider": {
      "enum": ["openrouter", "venice"],
      "description": "Pi provider name."
    },
    "defaultModel": {
      "type": "string",
      "description": "Model key used when the caller sets neither model nor kind."
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "description": "Model catalog keyed by the provider-neutral name callers pass as model.",
      "additionalProperties": {
        "$ref": "#/$defs/model"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "kinds": {
      "type": "object",
      "description": "Optional presets callers may pass as kind.",
      "additionalProperties": {
        "$ref": "#/$defs/kind"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "workspaceRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "Directories that working_directory and context_files must resolve inside. Root and home are refused.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "Absolute path, config-relative path, or @cwd (the MCP server process's working directory)."
      }
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1,
      "description": "Where per-run artifact directories are created (absolute or config-relative)."
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "description": "How Pi is launched.",
      "required": [
        "command",
        "arguments",
        "stateDirectory",
        "trustProjectFiles",
        "loadContextFiles"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Executable to run (default: pi on PATH)."
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "description": "Arguments placed before cyberdeck's own Pi flags.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "stateDirectory": {
          "type": [
            "string",
            "null"
          ],
          "description": "PI_CODING_AGENT_DIR for isolated Pi auth/settings, or null to reuse the user's Pi state."
        },
        "trustProjectFiles": {
          "type": "boolean",
          "description": "true passes --approve (trust project-local Pi extensions); false passes --no-approve."
        },
        "loadContextFiles": {
          "type": "boolean",
          "description": "false passes --no-context-files so Pi ignores AGENTS.md/CLAUDE.md."
        }
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "description": "Access policy behind the research and implement tools.",
      "required": [
        "research",
        "implementation"
      ],
      "properties": {
        "research": {
          "$ref": "#/$defs/profile",
          "description": "Read-only profile; its tools may not include bash, edit, or write."
        },
        "implementation": {
          "$ref": "#/$defs/profile",
          "description": "Write/shell-capable profile."
        }
      }
    }
  },
  "$defs": {
    "thinking": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Pi reasoning level."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "tier",
        "strengths",
        "providers"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "description": "Model family; implemented_by rejects a reviewer of the same family."
        },
        "tier": {
          "enum": [
            "cheap",
            "smart"
          ]
        },
        "strengths": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "One line the calling agent sees when choosing."
        },
        "defaultThinking": {
          "$ref": "#/$defs/thinking",
          "description": "Used when the caller omits thinking; required unless every provider thinking list is empty, and must be in every non-empty one."
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "openrouter": {
              "allOf": [
                {
                  "$ref": "#/$defs/providerModel"
                },
                {
                  "properties": {
                    "thinking": {
                      "minItems": 1
                    }
                  }
                }
              ]
            },
            "venice": {
              "$ref": "#/$defs/providerModel"
            }
          },
          "description": "Providers that serve this model; others omit it.",
          "minProperties": 1
        }
      }
    },
    "providerModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "thinking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Provider model ID passed to Pi."
        },
        "thinking": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/thinking"
          },
          "description": "Levels this provider accepts for the model; the installer pins Pi to exactly these. Venice only: [] means the provider sets thinking and callers may not."
        }
      }
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "preamble"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "Default model key for this kind."
        },
        "preamble": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Appended after the profile preamble; states the expected output."
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "codemode",
        "promptPreamble"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "description": "Exact Pi built-in or extension tool names. When codemode is on or only, Cyberdeck also passes codemode on --tools.",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "not": {
              "const": "codemode"
            }
          }
        },
        "codemode": {
          "enum": [
            "off",
            "on",
            "only"
          ],
          "description": "Pi's codemode tool: the model scripts these tools in a sandbox. on keeps them callable directly; only hides them behind codemode; off disables it."
        },
        "promptPreamble": {
          "type": "string",
          "maxLength": 4000,
          "description": "Appended to Pi's system prompt for every call to this tool."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-side ceilings; the MCP input schema mirrors the caller-facing ones.",
      "required": [
        "maxConcurrentRuns",
        "defaultTimeoutSeconds",
        "maxTimeoutSeconds",
        "defaultReturnCharacters",
        "maxReturnCharacters",
        "maxArtifactBytes",
        "maxTaskCharacters",
        "maxContextFiles"
      ],
      "properties": {
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Pi runs allowed at once; further calls are rejected, not queued."
        },
        "defaultTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Wall-clock limit when the caller omits timeout_seconds."
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Ceiling for timeout_seconds."
        },
        "defaultReturnCharacters": {
          "type": "integer",
          "minimum": 1,
          "description": "final_output cap when the caller omits return_characters."
        },
        "maxReturnCharacters": {
          "type": "integer",
          "minimum": 1,
          "description": "Ceiling for return_characters."
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1024,
          "description": "Combined stdout+stderr bytes captured per run; Pi is stopped beyond this."
        },
        "maxTaskCharacters": {
          "type": "integer",
          "minimum": 1,
          "description": "Ceiling for the task string."
        },
        "maxContextFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Ceiling for context_files entries."
        }
      }
    }
  }
}
