{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/cyberdeck.config.schema.json",
  "title": "Cyberdeck MCP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "workspaceRoots",
    "artifactDirectory",
    "pi",
    "limits",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provider": {
      "const": "openrouter"
    },
    "workspaceRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "Absolute path, config-relative path, or @cwd."
      }
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "arguments",
        "stateDirectory",
        "trustProjectFiles",
        "loadContextFiles"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "stateDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "trustProjectFiles": {
          "type": "boolean"
        },
        "loadContextFiles": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research",
        "implementation"
      ],
      "properties": {
        "research": {
          "$ref": "#/$defs/profile"
        },
        "implementation": {
          "$ref": "#/$defs/profile"
        }
      }
    }
  },
  "$defs": {
    "thinking": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelPatterns",
        "defaultThinking",
        "maxThinking",
        "tools",
        "promptPreamble"
      ],
      "properties": {
        "modelPatterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "defaultThinking": {
          "$ref": "#/$defs/thinking"
        },
        "maxThinking": {
          "$ref": "#/$defs/thinking"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "promptPreamble": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentRuns",
        "defaultTimeoutSeconds",
        "maxTimeoutSeconds",
        "defaultReturnCharacters",
        "maxReturnCharacters",
        "maxArtifactBytes",
        "maxTaskCharacters",
        "maxContextFiles"
      ],
      "properties": {
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "defaultTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "defaultReturnCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "maxReturnCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxTaskCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "maxContextFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
