{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cyberdeck": {
      "type": "local",
      "command": [
        "node",
        "/absolute/path/to/cyberdeck/bin/cyberdeck-mcp.mjs",
        "--config",
        "/absolute/path/to/cyberdeck/cyberdeck.config.json"
      ],
      "enabled": true
    }
  }
}
