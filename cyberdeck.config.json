{
  "$schema": "./cyberdeck.config.schema.json",
  "provider": "openrouter",
  "defaultModel": "deepseek-flash",
  "models": {
    "deepseek-flash": {
      "family": "deepseek",
      "tier": "cheap",
      "strengths": "Bulk reading, long-context recall, tests, docs.",
      "defaultThinking": "max",
      "providers": {
        "openrouter": {
          "id": "deepseek/deepseek-v4-flash-0731",
          "thinking": ["low", "high", "max"]
        },
        "venice": {
          "id": "deepseek-v4-flash-0731",
          "thinking": ["low", "high", "max"]
        }
      }
    },
    "deepseek-flash-4-1": {
      "family": "deepseek",
      "tier": "cheap",
      "strengths": "Planning, debugging, security review; fast.",
      "defaultThinking": "max",
      "providers": {
        "openrouter": {
          "id": "deepseek/deepseek-v4.1-flash",
          "thinking": ["off", "low", "high", "max"]
        },
        "venice": {
          "id": "deepseek-v4-1-flash",
          "thinking": ["off", "low", "high", "max"]
        }
      }
    },
    "glm-flash": {
      "family": "glm",
      "tier": "cheap",
      "strengths": "Implementation and tool loops; cheapest strong coder.",
      "defaultThinking": "max",
      "providers": {
        "openrouter": {
          "id": "z-ai/glm-5.3-flash",
          "thinking": ["low", "high", "max"]
        },
        "venice": {
          "id": "z-ai-glm-5-3-flash",
          "thinking": ["low", "high", "max"]
        }
      }
    },
    "mimo-flash": {
      "family": "mimo",
      "tier": "cheap",
      "strengths": "Tool calling; cross-family reviewer; weak on security.",
      "defaultThinking": "high",
      "providers": {
        "openrouter": {
          "id": "xiaomi/mimo-v2.6-flash",
          "thinking": ["off", "minimal", "low", "medium", "high"]
        }
      }
    },
    "deepseek-pro": {
      "family": "deepseek",
      "tier": "smart",
      "strengths": "Smart reader for very large context.",
      "defaultThinking": "high",
      "providers": {
        "openrouter": {
          "id": "deepseek/deepseek-v4-pro-0813",
          "thinking": ["low", "high", "max"]
        },
        "venice": {
          "id": "deepseek-v4-pro-0813",
          "thinking": ["low", "high", "max"]
        }
      }
    },
    "grok-4-7": {
      "family": "grok",
      "tier": "smart",
      "strengths": "Default smart worker; price doubles over 200K context.",
      "defaultThinking": "high",
      "providers": {
        "openrouter": {
          "id": "x-ai/grok-4.7",
          "thinking": ["low", "medium", "high", "xhigh"]
        },
        "venice": {
          "id": "grok-4-7",
          "thinking": ["low", "medium", "high", "xhigh"]
        }
      }
    },
    "kimi-k3": {
      "family": "kimi",
      "tier": "smart",
      "strengths": "Long-horizon autonomy and hard reviews; very verbose, priciest.",
      "defaultThinking": "high",
      "providers": {
        "openrouter": {
          "id": "moonshotai/kimi-k3",
          "thinking": ["low", "high", "max"]
        },
        "venice": {
          "id": "kimi-k3",
          "thinking": ["low", "high", "max"]
        }
      }
    }
  },
  "kinds": {
    "survey": {
      "model": "deepseek-flash",
      "preamble": "Report findings with file:line citations, separating facts, inferences, and unknowns."
    },
    "plan": {
      "model": "deepseek-flash-4-1",
      "preamble": "Return a plan: ordered steps, files touched, acceptance checks, and risks."
    },
    "implement": {
      "model": "glm-flash",
      "preamble": "Report changed files, checks run with results, and open issues."
    },
    "test": {
      "model": "deepseek-flash",
      "preamble": "Report tests added, what each covers, and their results."
    },
    "review": {
      "model": "grok-4-7",
      "preamble": "Return findings ranked by severity, each with location, defect, evidence, and fix."
    },
    "debug": {
      "model": "deepseek-flash-4-1",
      "preamble": "Report the root cause, evidence, fix, and how it was verified."
    },
    "docs": {
      "model": "deepseek-flash",
      "preamble": "Return only the requested text."
    }
  },
  "workspaceRoots": [
    "@cwd"
  ],
  "artifactDirectory": "./.cyberdeck/runs",
  "pi": {
    "command": "pi",
    "arguments": ["--no-extensions", "--no-skills"],
    "stateDirectory": null,
    "trustProjectFiles": false,
    "loadContextFiles": true
  },
  "limits": {
    "maxConcurrentRuns": 4,
    "defaultTimeoutSeconds": 600,
    "maxTimeoutSeconds": 1800,
    "defaultReturnCharacters": 3000,
    "maxReturnCharacters": 8000,
    "maxArtifactBytes": 10485760,
    "maxTaskCharacters": 50000,
    "maxContextFiles": 20
  },
  "profiles": {
    "research": {
      "tools": [
        "read",
        "grep",
        "find",
        "ls"
      ],
      "promptPreamble": "Investigate and report evidence. Do not modify files or external state. Clearly separate facts, inferences, and unknowns."
    },
    "implementation": {
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "bash",
        "edit",
        "write"
      ],
      "promptPreamble": "Implement only the requested change inside the supplied workspace. Preserve unrelated work, verify proportionately, and report changed files and checks."
    }
  }
}
